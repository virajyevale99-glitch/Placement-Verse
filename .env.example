# PlacementVerse — server-only configuration.
# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables. NONE of these may be prefixed NEXT_PUBLIC_.

# 1) Google Apps Script web-app URL (Deploy → Manage deployments → Web app URL, ends in /exec).
#    Leave empty locally to preview the site with fictional demo data (admin is disabled in that mode).
GOOGLE_APPS_SCRIPT_URL=

# 2) Shared secret that signs every request from this server to Apps Script (HMAC-SHA256).
#    Must be IDENTICAL to the APPS_SCRIPT_SHARED_SECRET script property. 32+ random characters.
#    Generate one with:  npm run gen-secret
APPS_SCRIPT_SHARED_SECRET=

# 3) Secret that signs admin session cookies. 32+ random characters, different from the one above.
#    Rotating it signs everyone out.   npm run gen-secret
ADMIN_SESSION_SECRET=

# 4) Admin password: no env var needed. Both administrators (viraj, uditi) use the fixed
#    password defined as ADMIN_PASSWORD in src/lib/auth/password.ts.

# 5) Optional, public: the site's own URL, used for Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not used (by design): GOOGLE_SHEETS_ID / GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY.
# The Apps Script is bound to the spreadsheet, so no Google credentials ever live in Vercel.
